<UserControl x:Class="AwbStudio.TimelineControls.ValueEditorSelectionContainerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AwbStudio.TimelineControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border x:Name="BorderEditorControls" BorderBrush="White" BorderThickness="1" Margin="0" Padding="5">
        <StackPanel Height="auto" x:Name="StackPanelEditorControls" MouseDown="StackPanelEditorControls_MouseDown">
            <StackPanel x:Name="StackPanelEditorControlsContainer" />
            <Label x:Name="LabelTitle" Content="Label" HorizontalAlignment="Left" Height="auto" />
        </StackPanel>
    </Border>
</UserControl>
